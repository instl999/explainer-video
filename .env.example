# explainer-video settings — copy this file to:
#     %USERPROFILE%\.explainer-video\.env        (e.g. C:/Users/<you>/.explainer-video/.env)
# Every project reads it. A project's own .env (same keys) overrides it; environment variables override both.
# Save as UTF-8 (the default paths contain Chinese). One KEY=value per line, no quotes needed; use / in paths.
# (scripts/new-project.mjs creates this file for you, with <you> filled in, the first time it runs.)

# Required. Volcano Ark (火山方舟) Agent Plan API key — used as X-Api-Key for TTS 2.0 (解说小明 2.0 etc.).
# Get it from the Ark console → Agent Plan. Never commit or share this file.
ARK_API_KEY=

# Music library: files named by mood label first (开头紧张…, 解释…, 结尾升华…). Default: %USERPROFILE%\Desktop\bgm
BGM_DIR=C:/Users/<you>/Desktop/bgm

# Sound-effect library (布斯的音效库). Role paths in engine/src/sfx-roles.ts are relative to this folder.
SFX_DIR=C:/Users/<you>/Desktop/布斯的音效库

# Optional. Where `npm run deliver` puts <title>_16比9讲解版.mp4/.srt. Default: the folder that holds the project.
# OUTPUT_DIR=C:/Users/<you>/tiktok

# Optional. Paid TTS results are cached here by request hash, so re-running the voice is free. Default: ~\.explainer-video\cache
# CACHE_DIR=C:/Users/<you>/.explainer-video/cache

# Optional. Default voice when script.json has no "speaker". 解说小明 2.0:
# TTS_SPEAKER=zh_male_jieshuoxiaoming_uranus_bigtts
# Optional. Resource id for TTS 2.0 (*_uranus_*) voices:
# TTS_RESOURCE_ID=seed-tts-2.0

# Optional. Folder holding ffmpeg.exe / ffprobe.exe if they are not from `winget install Gyan.FFmpeg` or on PATH.
# FFMPEG_DIR=C:/tools/ffmpeg/bin

# Optional. A font with Japanese glyphs (for book titles etc.). Default: C:/Windows/Fonts/YuGothB.ttc
# JP_FONT=C:/Windows/Fonts/YuGothB.ttc
